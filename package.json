{
  "name": "rastreador-contrataciones",
  "productName": "Rastreador de Contrataciones",
  "version": "1.0.0",
  "description": "Contrataciones publicas de Argentina en un grafo 3D de organismos, empresas y contratos, con presupuesto por ministerio y alertas de patrones. Datos publicos actualizados el 1 de cada mes.",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "base": "node tools/construir-base.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win portable nsis"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "ar.rastreador.contrataciones",
    "productName": "Rastreador de Contrataciones",
    "files": [
      "electron/**/*",
      "web/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "portable": {
      "artifactName": "Rastreador-Contrataciones-portable.exe"
    },
    "nsis": {
      "artifactName": "Rastreador-Contrataciones-instalador.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Rastreador de Contrataciones"
    },
    "directories": {
      "output": "dist",
      "buildResources": "build"
    }
  },
  "repository": "github:bmfoundationbm-netizen/rastreador-contrataciones",
  "homepage": "https://bmfoundationbm-netizen.github.io/rastreador-contrataciones/"
}
